@page
@model GarageTracking.Pages.Invoices.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Invoices</h1>

<p>
    <a class="btn-grey" asp-page="Create">Create New</a>
</p>

<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by name:
            <input type="text" name="SearchString" value="@Model.CurrentFilter" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a class="btn-grey" asp-page="./Index">Back to full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.InvoiceDateSort">Invoice Date</a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.BookingIDSort">Booking ID</a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.CustomerSort">Customer Name</a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.VehicleRegistrationSort">Vehicle Registration</a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.ServiceDateSort">Service Date</a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.ServiceTypeSort">Service Type</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Invoice) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.InvoiceDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Booking.BookingID)
            </td>
            <td>
                @($"{item.Booking.Vehicle.Customer.FirstName} {item.Booking.Vehicle.Customer.LastName}")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Booking.Vehicle.Registration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Booking.ServiceDate) 
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Booking.ServiceType)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.InvoiceID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.InvoiceID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.InvoiceID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    var prevDisabled = !Model.Invoice.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Invoice.HasNextPage ? "disabled" : "";
}

<a asp-page="./Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.Invoice.PageIndex - 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-primary @prevDisabled">
    Previous
</a>
<a asp-page="./Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.Invoice.PageIndex + 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-primary @nextDisabled">
    Next
</a>