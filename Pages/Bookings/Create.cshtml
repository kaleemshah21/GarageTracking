@page
@model GarageTracking.Pages.Bookings.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Booking</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Booking.VehicleID" class="control-label">Vehicle Registration</label>
                <select asp-for="Booking.VehicleID" class ="form-control" asp-items="ViewBag.VehicleID"></select>
            </div>
            <div class="form-group">
                <label asp-for="Booking.ServiceType" class="control-label"></label>
                <input asp-for="Booking.ServiceType" class="form-control" />
                <span asp-validation-for="Booking.ServiceType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.ServiceDate" class="control-label"></label>
                <input asp-for="Booking.ServiceDate" class="form-control" />
                <span asp-validation-for="Booking.ServiceDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.Price" class="control-label"></label>
                <input asp-for="Booking.Price" class="form-control" />
                <span asp-validation-for="Booking.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.Status" class="control-label"></label>
                <select asp-for="Booking.Status" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewData["Status"])">
                    <option value="">Select a Status</option>
                </select>
                <span asp-validation-for="Booking.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
