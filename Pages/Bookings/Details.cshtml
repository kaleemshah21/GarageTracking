@page
@model GarageTracking.Pages.Bookings.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.ServiceType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Booking.ServiceType)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.ServiceDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Booking.ServiceDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Booking.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Booking.Status)
        </dd>
        <dt class="col-sm-2">
            Vehicle Registration
        </dt>
        <dd class="col-sm-10">
            @(Model.Booking.Vehicle?.Registration ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            Vehicle Make
        </dt>
        <dd class="col-sm-10">
            @(Model.Booking.Vehicle?.CarMake ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            Vehicle Model
        </dt>
        <dd class="col-sm-10">
            @(Model.Booking.Vehicle?.CarModel ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            Customer Name
        </dt>
        <dd class="col-sm-10">
            @((Model.Booking.Vehicle?.Customer?.FirstName ?? "N/A") + " " + (Model.Booking.Vehicle?.Customer?.LastName ?? ""))
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Booking.BookingID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
