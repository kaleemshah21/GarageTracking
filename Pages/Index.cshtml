@page
@model IndexModel
@{
    ViewData["Title"] = "Garage Dashboard";
}

@{
    Response.Headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
    Response.Headers["Pragma"] = "no-cache";
    Response.Headers["Expires"] = "0";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>Welcome to Your Garage Dashboard</h2>
                <div>

                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <h5 class="card-title">Total Active Bookings</h5>
                    <h3>@Model.TotalActiveBookings</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <h5 class="card-title">Services Completed Today</h5>
                    <h3>@Model.ServicesCompletedToday</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <h3>@Model.TotalSales.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <h5 class="card-title">Total Customers</h5>
                    <h3>@Model.TotalCustomers</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
      
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Customers/Create" class="btn btn-secondary">Add New Customer</a>
                        <a href="/Vehicles/Create" class="btn btn-secondary">Create New Vehicle</a>
                        <a href="/Bookings/Create" class="btn btn-secondary">Create New Booking</a>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="col-md-8 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5>Upcoming Appointments / Bookings</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @foreach (var booking in Model.NewestBookings)
                        {
                            
                            var dateDifference = booking.ServiceDate.Date - DateTime.Now.Date;
                            string timeStatus = "";

                            if (dateDifference.Days == 0)
                            {
                                timeStatus = "Today";
                            }
                            else if (dateDifference.Days == 1)
                            {
                                timeStatus = "Tomorrow";
                            }
                            else if (dateDifference.Days < 0)
                            {
                                timeStatus = "Past";
                            }
                            else
                            {
                                timeStatus = booking.ServiceDate.ToString("MM/dd/yyyy");
                            }

                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6>@booking.Vehicle.Customer.FirstName @booking.Vehicle.Customer.LastName - @booking.ServiceType</h6>
                                    <p>Vehicle: @booking.Vehicle.CarMake @booking.Vehicle.CarModel - Service Date: @booking.ServiceDate.ToString("MM/dd/yyyy")</p>
                                </div>
                                <span class="badge bg-primary">@timeStatus</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

            @*  <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Recent Activity</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <li class="list-group-item">@activity</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div> 

