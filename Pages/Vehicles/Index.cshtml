@page
@model GarageTracking.Pages.Vehicles.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.CarMakeSort">
                    @Html.DisplayNameFor(model => model.Vehicle[0].CarMake)
                </a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.CarModelSort">
                    @Html.DisplayNameFor(model => model.Vehicle[0].CarModel)
                </a>

            </th>
            
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.RegistrationSort">
                    @Html.DisplayNameFor(model => model.Vehicle[0].Registration)
                </a>
            </th>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.CustomerSort">
                    @Html.DisplayNameFor(model => model.Vehicle[0].Customer)
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Vehicle) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CarMake)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CarModel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Registration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.FirstName) @Html.DisplayFor(modelItem => item.Customer.LastName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.VehicleId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.VehicleId">Details</a> |
                @* <a asp-page="./Delete" asp-route-id="@item.VehicleId">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>
