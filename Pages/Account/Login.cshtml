@page
@model GarageTracking.Pages.Account.LoginModel

<h2>Login</h2>

<div class="login-form-container">
    <form method="post" class="login-form">
        <div class="form-group login-username-group">
            <label asp-for="Username" class="login-label"></label>
            <input asp-for="Username" class="login-form-control" />
        </div>
        <div class="form-group login-password-group">
            <label asp-for="Password" class="login-label"></label>
            <input asp-for="Password" type="password" class="login-form-control" />
        </div>
        <button type="submit" class="btn login-btn">Login</button>
    </form>
</div>


@section Scripts {
    <script type="text/javascript">
        // Check if there is an alert message
        @if (!string.IsNullOrEmpty(Model.AlertMessage))
        {
            <text>
                alert('@Model.AlertMessage');
            </text>
        }
    </script>
}
